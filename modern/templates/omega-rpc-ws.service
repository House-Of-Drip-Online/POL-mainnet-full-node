[Unit]
Description=OMEGA private Polygon WebSocket RPC gateway (port 8546)
After=network-online.target bor.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=OMEGA_CONFIGURATION_CONTEXT=RUNTIME
Type=simple
User=omega-rpc
Group=nogroup
ExecStart=/usr/bin/python3 /opt/omega-polygon/modern/rpc_ws_proxy.py --bind @PRIVATE_IP@
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/run/omega-polygon
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
