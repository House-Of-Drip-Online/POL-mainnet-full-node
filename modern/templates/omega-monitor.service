[Unit]
Description=OMEGA Polygon continuous readiness and evidence
After=network-online.target heimdalld.service
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/omega-polygon/modern/monitor.py
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=omega-polygon
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/omega-polygon
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
